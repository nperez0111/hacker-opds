{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "mono-jsx",
    "types": ["bun", "mono-jsx"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["server", "src", "*.ts", "*.tsx"],
  "exclude": ["node_modules", ".output", ".nitro", ".data"]
}
