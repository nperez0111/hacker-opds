{
  "name": "hacker-opds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Top Hacker News stories as EPUBs over OPDS and articles over RSS, for e-ink readers",
  "license": "MIT",
  "scripts": {
    "dev": "LOG_PRETTY=true LOG_LEVEL=debug bun --bun vite --host",
    "build": "vite build && bun run scripts/build-ops.ts",
    "start": "bun run ./.output/server/index.mjs",
    "test": "bun test",
    "test:integration": "RUN_INTEGRATION=1 bun test tests/integration",
    "probe": "bun run scripts/opds-probe.ts",
    "fonts:build": "bun run scripts/build-fonts.ts",
    "icon:build": "bun run scripts/build-icon.ts",
    "ingest": "bun run scripts/ingest.ts",
    "reindex": "bun run scripts/reindex.ts",
    "reset": "bun run scripts/reset.ts",
    "health": "curl -s localhost:3000/healthz",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "defuddle": "0.19.2",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "jszip": "3.10.1",
    "linkedom": "0.18.13",
    "luxon": "3.7.2",
    "mono-jsx": "0.9.14",
    "nitro": "3.0.260610-beta",
    "p-limit": "7.3.1",
    "pino": "10.3.1",
    "rehype-parse": "9.0.1",
    "robots-parser": "3.0.1",
    "turndown": "7.2.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "7.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/luxon": "3.7.1",
    "@types/turndown": "5.0.6",
    "fast-xml-parser": "5.11.0",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.2"
  }
}
